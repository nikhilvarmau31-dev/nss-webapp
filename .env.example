# ─── Firebase / Firestore Configuration ────────────────────────────────────
# Choose ONE of the two options below to supply Firebase service account credentials.

# Option A: Inline JSON string of your service account key
# Paste the entire contents of your serviceAccountKey.json as a single-line JSON string.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: Path to a service account JSON key file on disk
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# ─── Optional: Flask Secret Key ─────────────────────────────────────────────
# Used for session signing. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# ─── Google OAuth Single Sign-On (@mvgrce.edu.in) ─────────────────────────
# Optional: Set these to enable 1-click Google OAuth redirect / GIS popup
# Found in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: Email / SMTP Settings ────────────────────────────────────────
CONTACT_RECIPIENT_EMAIL=support.nssmvgr@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.nssmvgr@gmail.com
SMTP_PASSWORD=
